{
  "name": "dsh-remote",
  "version": "1.0.0",
  "description": "Reach this machine's DeepSeek Harness from anywhere: a public entry point, a relay you configure inside dsh, and a mobile shell for the existing web GUI.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client.js"
  },
  "icon": "./public/remote.svg",
  "meta": {
    "title": "dsh remote",
    "description": "从任何地方访问这台机器的 dsh：在设置里配置一台中继服务器，手机就能打开同一份工作区、同一份聊天记录。"
  },
  "bin": {
    "dsh-remote": "./bin/dsh-remote.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "remote-access",
    "cloudflare-tunnel",
    "ssh-tunnel",
    "mobile",
    "cordis-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guuu16/dsh-remote.git"
  },
  "homepage": "https://github.com/Guuu16/dsh-remote#readme",
  "license": "MIT",
  "scripts": {
    "test": "node test/run.mjs",
    "verify": "node test/verify-live.mjs"
  }
}
